# ---------------------------------------------------------------- Supabase Realtime (chat)
# Supabase Dashboard → Project Settings → Data API (URL) và API Keys (2 key).
# Realtime → Settings: bật "Allow public access" (kênh broadcast công khai, tên kênh đã băm).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable key (sb_publishable_...) hoặc key "anon" — công khai, trình duyệt dùng để nghe.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Secret key (sb_secret_...) hoặc "service_role" — CHỈ server dùng. Không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# ---------------------------------------------------------------- Database (Supabase)
# Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: "Transaction pooler" (port 6543) — app runtime dùng cái này.
#   Bắt buộc có ?pgbouncer=true để Prisma tắt prepared statements.
# DIRECT_URL:   "Session pooler"/"Direct connection" (port 5432) — prisma migrate & seed dùng.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- Auth.js
# Sinh bằng: npx auth secret   (hoặc: openssl rand -base64 32)
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-ky-tu"

# URL gốc của app. Dev để nguyên; production đổi thành domain thật.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- Ảnh upload
# Thư mục lưu ảnh đại diện / ảnh bìa (LocalDiskImageStorage). Bỏ trống = ./storage/uploads.
# Serverless (Vercel...) không có ổ đĩa bền → cần thay bằng S3/Supabase Storage.
# UPLOAD_DIR="/var/data/sportmatch-uploads"
